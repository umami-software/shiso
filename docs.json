{
  "$schema": "./node_modules/@umami/shiso/docs.schema.json",
  "$shiso": {
    "siteUrl": "https://shiso.umami.is"
  },
  "theme": "shiso",
  "name": "shiso",
  "description": "Open-source docs site generator built with Vite, React, and MDX.",
  "logo": "/logo.svg",
  "favicon": "/logo.svg",
  "navbar": {
    "links": [
      {
        "icon": "github",
        "ariaLabel": "GitHub",
        "href": "https://github.com/umami-software/shiso"
      }
    ]
  },
  "footer": {
    "socials": [
      {
        "icon": "github",
        "ariaLabel": "GitHub",
        "href": "https://github.com/umami-software/shiso"
      },
      {
        "icon": "x",
        "ariaLabel": "X",
        "href": "https://x.com/umami_software"
      }
    ]
  },
  "redirects": [
    { "source": "/docs/guides/migrating", "destination": "/docs/guides/migrations/mintlify" }
  ],
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "collapsible": false,
            "pages": [{ "page": "index", "title": "Introduction" }, "installation"]
          },
          {
            "group": "Configuration",
            "pages": [
              { "page": "configuration", "title": "Overview" },
              "site-details",
              "navigation",
              { "page": "customization", "title": "Appearance" },
              { "page": "navbar-and-footer", "title": "Header, footer, and banner" },
              { "page": "search-and-ai", "title": "Search and AI" },
              "versions",
              "languages",
              { "page": "seo", "title": "SEO, redirects, and errors" },
              { "page": "project-settings", "title": "URLs and content location" },
              { "page": "configuration-references", "title": "Split configuration with $ref" },
              "troubleshooting"
            ]
          },
          {
            "group": "Writing content",
            "pages": [
              { "page": "writing-content", "title": "Overview" },
              "text",
              "images",
              "lists",
              "tables",
              { "page": "code-blocks", "title": "Code" }
            ]
          },
          {
            "group": "Components",
            "pages": [
              { "page": "components/index", "title": "Overview" },
              "components/accordion",
              "components/badge",
              "components/callout",
              "components/card",
              "components/code-group",
              "components/columns",
              "components/expandable",
              "components/frame",
              "components/icon",
              "components/param-field",
              "components/response-field",
              "components/steps",
              "components/tabs",
              "components/tooltip"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Guides",
            "collapsible": false,
            "pages": ["guides/deployment", "guides/upgrading"]
          },
          {
            "group": "Migrations",
            "collapsible": false,
            "pages": [
              { "page": "guides/migrations/mintlify", "title": "From Mintlify" },
              { "page": "guides/migrations/docusaurus", "title": "From Docusaurus" },
              { "page": "guides/migrations/nextra", "title": "From Nextra" },
              { "page": "guides/migrations/fumadocs", "title": "From Fumadocs" },
              { "page": "guides/migrations/vitepress", "title": "From VitePress" },
              { "page": "guides/migrations/mkdocs", "title": "From MkDocs" },
              { "page": "guides/migrations/gitbook", "title": "From GitBook" }
            ]
          }
        ]
      }
    ]
  }
}

{
  "$schema": "./docs.schema.json",
  "$shiso": {
    "siteUrl": "https://shiso.dev"
  },
  "name": "Shiso",
  "description": "Open-source docs site generator built with Vite, React, and MDX.",
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/umami-software/shiso"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/umami-software/shiso",
      "x": "https://x.com/umami_software"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "installation"]
          },
          {
            "group": "Configuration",
            "pages": ["configuration", "navigation", "troubleshooting"]
          },
          {
            "group": "Writing content",
            "pages": ["writing-content", "text", "images", "lists", "code-blocks"]
          }
        ]
      },
      {
        "tab": "Components",
        "groups": [
          {
            "group": "Components",
            "pages": [
              "components/index",
              "components/accordion",
              "components/badge",
              "components/callout",
              "components/card",
              "components/code-group",
              "components/columns",
              "components/examples",
              "components/expandable",
              "components/frame",
              "components/icon",
              "components/param-field",
              "components/response-field",
              "components/steps",
              "components/tabs",
              "components/tooltip"
            ]
          }
        ]
      }
    ]
  }
}

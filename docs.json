{
  "$schema": "./docs.schema.json",
  "$shiso": {
    "siteUrl": "https://shiso.dev"
  },
  "theme": "shiso",
  "name": "shiso",
  "description": "Open-source docs site generator built with Vite, React, and MDX.",
  "logo": "/logo.svg",
  "favicon": "/logo.svg",
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/umami-software/shiso"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/umami-software/shiso",
      "x": "https://x.com/umami_software"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "collapsible": false,
            "pages": [{ "page": "index", "title": "Introduction" }, "quickstart"]
          },
          {
            "group": "Configuration",
            "pages": [
              { "page": "configuration", "title": "Overview" },
              "navigation",
              "customization",
              "navbar-and-footer",
              { "page": "seo", "title": "SEO and redirects" },
              { "page": "search-and-ai", "title": "Search and AI" },
              "troubleshooting"
            ]
          },
          {
            "group": "Writing content",
            "pages": [
              { "page": "writing-content", "title": "Overview" },
              "text",
              "images",
              "lists",
              "code-blocks"
            ]
          },
          {
            "group": "Components",
            "pages": [
              { "page": "components/index", "title": "Overview" },
              "components/accordion",
              "components/badge",
              "components/callout",
              "components/card",
              "components/code-group",
              "components/columns",
              "components/expandable",
              "components/frame",
              "components/icon",
              "components/param-field",
              "components/response-field",
              "components/steps",
              "components/tabs",
              "components/tooltip"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Guides",
            "collapsible": false,
            "pages": [
              "guides/deployment",
              { "page": "guides/migrating", "title": "Migrating from Mintlify" }
            ]
          }
        ]
      }
    ]
  }
}

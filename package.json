{
  "name": "shiso",
  "version": "0.61.0",
  "private": true,
  "description": "Open-source docs site generator built with Vite, React, and MDX. Configured with a single docs.json file.",
  "homepage": "https://shiso.umami.is",
  "repository": {
    "type": "git",
    "url": "https://github.com/umami-software/shiso.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 8001",
    "check:config": "node scripts/validate-config.mjs",
    "build": "node scripts/validate-config.mjs && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "preview": "vite preview --outDir dist/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check . --vcs-use-ignore-file=true --files-ignore-unknown=true",
    "lint:fix": "biome check --write . --vcs-use-ignore-file=true --files-ignore-unknown=true",
    "format": "biome format --write . --vcs-use-ignore-file=true --files-ignore-unknown=true",
    "icons": "svgr ./src/assets --out-dir src/components/svg --typescript",
    "icons:registry": "node scripts/generate-icon-registry.mjs",
    "timestamps": "node scripts/generate-last-modified.mjs",
    "search:index": "node scripts/generate-search-index.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@mdx-js/react": "^3.1.1",
    "classnames": "^2.5.1",
    "estree-util-value-to-estree": "^3.5.0",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^8.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@svgr/cli": "^8.1.0",
    "@types/css-modules": "^1.0.5",
    "@types/mdx": "^2.0.11",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.20.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "remark-parse": "^11.0.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}

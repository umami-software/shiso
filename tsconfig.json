{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "noImplicitAny": false,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "es2022"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "docs.json"],
  "exclude": ["node_modules", "dist"]
}

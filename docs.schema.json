{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "docs.schema.json",
  "title": "Shiso docs.json",
  "description": "Configuration for a Shiso docs site. Recognized keys are annotated with \"x-shiso\": \"supported\" (implemented and strictly validated) or \"x-shiso\": \"reserved\" (recognized, accepted and ignored, and loosely validated). Keys absent from this file are rejected. See scripts/validate-config.mjs.",
  "type": "object",
  "anyOf": [{ "required": ["$ref"] }, { "required": ["navigation"] }],
  "additionalProperties": false,
  "properties": {
    "$ref": {
      "x-shiso": "supported",
      "$ref": "#/definitions/configRef"
    },
    "$schema": {
      "x-shiso": "supported",
      "type": "string",
      "description": "Path or URL to this schema, for editor autocomplete."
    },
    "$shiso": {
      "x-shiso": "supported",
      "type": "object",
      "description": "Shiso-only options. Namespaced so the rest of the file stays portable.",
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "docsPrefix": {
          "type": "string",
          "description": "Route prefix for docs pages. Defaults to \"/docs\"; use \"\" to serve docs at the site root.",
          "default": "/docs"
        },
        "contentDir": {
          "type": "string",
          "description": "Content directory relative to the project root.",
          "default": "content/docs"
        },
        "siteUrl": {
          "type": "string",
          "description": "Absolute site origin (e.g. \"https://docs.example.com\"). Required for canonical, og:url, and structured data."
        },
        "locale": {
          "type": "string",
          "minLength": 1,
          "description": "Locale used for dates and theme-provided interface copy. Defaults to en-US."
        }
      }
    },
    "name": {
      "x-shiso": "supported",
      "type": "string",
      "minLength": 1,
      "description": "Site name, shown in the header and the page title."
    },
    "description": {
      "x-shiso": "supported",
      "type": "string",
      "description": "Default meta description for pages without one."
    },
    "colors": {
      "x-shiso": "supported",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "primary": {
          "type": "string",
          "description": "Primary accent color (any CSS color)."
        },
        "light": {
          "type": "string",
          "description": "Accent color used in dark mode."
        },
        "dark": {
          "type": "string",
          "description": "Fallback accent color when primary is omitted."
        }
      }
    },
    "logo": {
      "x-shiso": "supported",
      "oneOf": [
        {
          "type": "string",
          "description": "Path to the logo image, relative to the public directory."
        },
        {
          "type": "object",
          "anyOf": [
            { "required": ["$ref"] },
            { "required": ["light"] },
            { "required": ["dark"] }
          ],
          "additionalProperties": false,
          "properties": {
            "$ref": { "$ref": "#/definitions/configRef" },
            "light": { "type": "string", "description": "Logo shown in light mode." },
            "dark": { "type": "string", "description": "Logo shown in dark mode." },
            "href": {
              "type": "string",
              "description": "URL the logo links to. Defaults to the docs root."
            },
            "target": {
              "enum": ["_self", "_blank"],
              "description": "Browsing context for the logo link. Defaults from href."
            }
          }
        }
      ]
    },
    "favicon": {
      "x-shiso": "supported",
      "type": "string",
      "description": "Path to the favicon, relative to the public directory."
    },
    "navigation": {
      "x-shiso": "supported",
      "type": "object",
      "description": "Site navigation. Define exactly one of: tabs, dropdowns, versions, languages, or top-level groups/pages.",
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "tabs": { "type": "array", "items": { "$ref": "#/definitions/tab" } },
        "dropdowns": { "type": "array", "items": { "$ref": "#/definitions/dropdown" } },
        "anchors": { "type": "array", "items": { "$ref": "#/definitions/anchor" } },
        "versions": { "type": "array", "items": { "$ref": "#/definitions/version" } },
        "languages": { "type": "array", "items": { "$ref": "#/definitions/language" } },
        "groups": { "type": "array", "items": { "$ref": "#/definitions/group" } },
        "pages": { "type": "array", "items": { "$ref": "#/definitions/pageItem" } },
        "global": {
          "x-shiso": "reserved",
          "type": "object",
          "description": "Navigation items shown across every tab and version."
        },
        "products": {
          "x-shiso": "reserved",
          "type": "array",
          "description": "Product switcher entries."
        }
      }
    },

    "theme": {
      "x-shiso": "supported",
      "type": "string",
      "enum": ["shiso"],
      "default": "shiso",
      "description": "Layout theme name. Only \"shiso\" is implemented."
    },
    "thumbnails": { "x-shiso": "reserved", "type": "object" },
    "styling": {
      "x-shiso": "supported",
      "type": "object",
      "description": "Visual styling configuration.",
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "eyebrows": {
          "enum": ["section", "breadcrumbs"],
          "description": "Page eyebrow style: the section name (default) or the full navigation path.",
          "default": "section"
        },
        "latex": {
          "x-shiso": "reserved",
          "type": "boolean",
          "description": "LaTeX stylesheet loading is not implemented yet; accepted and ignored."
        },
        "codeblocks": {
          "x-shiso": "reserved",
          "description": "Code block themes are not implemented yet; accepted and ignored."
        }
      }
    },
    "icons": { "x-shiso": "reserved", "type": "object" },
    "fonts": {
      "x-shiso": "supported",
      "type": "object",
      "description": "Custom fonts. Google Fonts families load automatically; use source/format for self-hosted files.",
      "anyOf": [{ "required": ["$ref"] }, { "required": ["family"] }],
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "family": { "type": "string", "description": "Font family name, e.g. \"Open Sans\"." },
        "weight": { "type": "number", "description": "Font weight, e.g. 400 or 700." },
        "source": { "type": "string", "description": "URL or path to a hosted font file." },
        "format": { "enum": ["woff", "woff2"], "description": "Font file format, for `source`." },
        "heading": { "$ref": "#/definitions/fontSpec", "description": "Override for headings." },
        "body": { "$ref": "#/definitions/fontSpec", "description": "Override for body text." }
      }
    },
    "appearance": {
      "x-shiso": "supported",
      "type": "object",
      "description": "Light/dark mode defaults.",
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "default": {
          "enum": ["system", "light", "dark"],
          "description": "Initial theme mode. \"system\" follows the OS preference.",
          "default": "system"
        },
        "strict": {
          "type": "boolean",
          "description": "Hide the light/dark toggle and ignore stored preferences.",
          "default": false
        }
      }
    },
    "background": {
      "x-shiso": "supported",
      "type": "object",
      "description": "Background color and image settings.",
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "image": {
          "description": "Background image, a single path or per-mode paths.",
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "anyOf": [
                { "required": ["$ref"] },
                { "required": ["light"] },
                { "required": ["dark"] }
              ],
              "additionalProperties": false,
              "properties": {
                "$ref": { "$ref": "#/definitions/configRef" },
                "light": { "type": "string" },
                "dark": { "type": "string" }
              }
            }
          ]
        },
        "decoration": {
          "x-shiso": "reserved",
          "enum": ["gradient", "grid", "windows"],
          "description": "Theme decorations are not implemented yet; accepted and ignored."
        },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "$ref": { "$ref": "#/definitions/configRef" },
            "light": { "type": "string", "description": "Background color for light mode." },
            "dark": { "type": "string", "description": "Background color for dark mode." }
          }
        }
      }
    },
    "interaction": {
      "x-shiso": "supported",
      "type": "object",
      "description": "Navigation interaction settings.",
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "drilldown": {
          "type": "boolean",
          "description": "Collapsible-group click behavior: true navigates to the group's first page on expand, false only expands/collapses. Unset uses the default (headers with a root page navigate, others toggle)."
        }
      }
    },
    "search": {
      "x-shiso": "supported",
      "description": "Search settings. Set to false to disable search.",
      "oneOf": [
        { "const": false },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "$ref": { "$ref": "#/definitions/configRef" },
            "prompt": {
              "type": "string",
              "description": "Placeholder text for the search input."
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "description": "Registered search provider id. Defaults to local."
            },
            "options": {
              "type": "object",
              "description": "Provider-specific configuration."
            },
            "shortcut": {
              "description": "Single Cmd/Ctrl shortcut key, or false to disable it.",
              "oneOf": [
                { "type": "string", "minLength": 1, "maxLength": 1 },
                { "const": false }
              ]
            },
            "shortcutLabel": {
              "type": "string",
              "minLength": 1,
              "description": "Text displayed for the configured search shortcut."
            }
          }
        }
      ]
    },
    "contextual": {
      "x-shiso": "supported",
      "type": "object",
      "description": "Contextual menu shown beside the page title. \"mcp\", \"cursor\", and \"vscode\" require a hosted MCP server and are accepted but skipped.",
      "anyOf": [{ "required": ["$ref"] }, { "required": ["options"] }],
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "options": {
          "type": "array",
          "description": "Menu entries, in order; the first is the primary button.",
          "items": {
            "oneOf": [
              {
                "enum": [
                  "copy",
                  "view",
                  "chatgpt",
                  "claude",
                  "perplexity",
                  "mcp",
                  "cursor",
                  "vscode"
                ]
              },
              {
                "type": "object",
                "anyOf": [{ "required": ["$ref"] }, { "required": ["title", "href"] }],
                "additionalProperties": false,
                "properties": {
                  "$ref": { "$ref": "#/definitions/configRef" },
                  "title": { "type": "string", "description": "Menu entry title." },
                  "description": { "type": "string", "description": "Menu entry description." },
                  "icon": { "type": "string", "description": "Icon name rendered with the action." },
                  "target": {
                    "enum": ["_self", "_blank"],
                    "description": "Browsing context for the action. Defaults from the destination URL."
                  },
                  "href": {
                    "type": "string",
                    "description": "Destination URL. \"$path\" expands to the page path, \"$page\" to the page's markdown URL."
                  }
                }
              }
            ]
          }
        }
      }
    },
    "navbar": {
      "x-shiso": "supported",
      "type": "object",
      "description": "Links and primary button in the top navigation bar.",
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "anyOf": [
              { "required": ["$ref"] },
              {
                "required": ["href"],
                "anyOf": [{ "required": ["label"] }, { "required": ["icon"] }]
              }
            ],
            "additionalProperties": false,
            "properties": {
              "$ref": { "$ref": "#/definitions/configRef" },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "Visible link text. Omit for an icon-only link."
              },
              "href": { "type": "string", "minLength": 1, "description": "Destination URL." },
              "ariaLabel": {
                "type": "string",
                "minLength": 1,
                "description": "Accessible text for an icon-only link."
              },
              "icon": {
                "type": "string",
                "minLength": 1,
                "description": "Icon name. Rendered alone when label is omitted."
              },
              "target": {
                "enum": ["_self", "_blank"],
                "description": "Browsing context. Defaults to _self for local links and _blank for external links."
              },
              "iconType": {
                "x-shiso": "reserved",
                "type": "string",
                "description": "Font Awesome icon style. Shiso uses the lucide icon set."
              }
            }
          }
        },
        "primary": {
          "type": "object",
          "anyOf": [
            { "required": ["$ref"] },
            {
              "required": ["href"],
              "anyOf": [{ "required": ["label"] }, { "required": ["icon"] }]
            }
          ],
          "additionalProperties": false,
          "properties": {
            "$ref": { "$ref": "#/definitions/configRef" },
            "label": { "type": "string", "minLength": 1, "description": "Visible button text. Omit for icon-only." },
            "href": { "type": "string", "minLength": 1, "description": "Button destination URL." },
            "icon": { "type": "string", "minLength": 1, "description": "Icon name." },
            "ariaLabel": { "type": "string", "minLength": 1, "description": "Accessible text for icon-only buttons." },
            "target": {
              "enum": ["_self", "_blank"],
              "description": "Browsing context. Defaults from the destination URL."
            }
          }
        }
      }
    },
    "metadata": {
      "x-shiso": "supported",
      "type": "object",
      "description": "Page metadata settings.",
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "timestamp": {
          "type": "boolean",
          "description": "Show the last-modified date (from git history) on all pages. Override per page with the `timestamp` frontmatter field.",
          "default": false
        }
      }
    },
    "footer": {
      "x-shiso": "supported",
      "type": "object",
      "description": "Footer content: social links and link columns.",
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "socials": {
          "type": "array",
          "description": "Social links displayed in the footer.",
          "items": {
            "type": "object",
            "anyOf": [
              { "required": ["$ref"] },
              {
                "required": ["href"],
                "anyOf": [{ "required": ["label"] }, { "required": ["icon"] }]
              }
            ],
            "additionalProperties": false,
            "properties": {
              "$ref": { "$ref": "#/definitions/configRef" },
              "href": { "type": "string" },
              "label": { "type": "string", "description": "Visible link text." },
              "icon": { "type": "string" },
              "ariaLabel": { "type": "string" },
              "target": { "enum": ["_self", "_blank"] }
            }
          }
        },
        "links": {
          "type": "array",
          "description": "Link columns displayed above the footer bottom row.",
          "items": {
            "type": "object",
            "anyOf": [{ "required": ["$ref"] }, { "required": ["items"] }],
            "additionalProperties": false,
            "properties": {
              "$ref": { "$ref": "#/definitions/configRef" },
              "header": { "type": "string", "description": "Column heading." },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "anyOf": [{ "required": ["$ref"] }, { "required": ["label", "href"] }],
                  "additionalProperties": false,
                  "properties": {
                    "$ref": { "$ref": "#/definitions/configRef" },
                    "label": { "type": "string", "description": "Link text." },
                    "href": { "type": "string", "description": "Link destination URL." },
                    "target": { "enum": ["_self", "_blank"] }
                  }
                }
              }
            }
          }
        },
        "attribution": {
          "type": "boolean",
          "description": "Show the Shiso attribution in the footer. Defaults to true.",
          "default": true
        }
      }
    },
    "banner": {
      "x-shiso": "supported",
      "type": "object",
      "description": "Site-wide banner displayed above the header.",
      "anyOf": [{ "required": ["$ref"] }, { "required": ["content"] }],
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "content": {
          "type": "string",
          "description": "Banner text. Supports basic markdown: links, bold, italic, and inline code."
        },
        "dismissible": {
          "type": "boolean",
          "description": "Show a dismiss button. Dismissal persists until the content changes.",
          "default": false
        }
      }
    },
    "redirects": {
      "x-shiso": "supported",
      "type": "array",
      "description": "Redirects for moved, renamed, or deleted pages. Sources are matched exactly; wildcard patterns are not implemented yet and are skipped with a warning.",
      "items": {
        "type": "object",
        "anyOf": [{ "required": ["$ref"] }, { "required": ["source", "destination"] }],
        "additionalProperties": false,
        "properties": {
          "$ref": { "$ref": "#/definitions/configRef" },
          "source": { "type": "string", "description": "Path to redirect from, e.g. \"/old-page\"." },
          "destination": {
            "type": "string",
            "description": "Path or URL to redirect to, e.g. \"/new-page\"."
          },
          "permanent": {
            "type": "boolean",
            "description": "Accepted for portability. Static output cannot vary the status code; every redirect is a meta refresh page.",
            "default": true
          }
        }
      }
    },
    "api": { "x-shiso": "reserved", "type": "object" },
    "seo": {
      "x-shiso": "supported",
      "type": "object",
      "description": "SEO indexing configuration.",
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "metatags": {
          "type": "object",
          "description": "Meta tags added to every page, e.g. { \"og:image\": \"/social.png\" }.",
          "additionalProperties": { "type": "string" }
        },
        "indexing": {
          "enum": ["navigable", "all"],
          "description": "\"navigable\" (default) marks hidden pages noindex and keeps them out of the sitemap; \"all\" indexes every page.",
          "default": "navigable"
        }
      }
    },
    "integrations": { "x-shiso": "reserved", "type": "object" },
    "errors": {
      "x-shiso": "supported",
      "type": "object",
      "description": "Error handling settings.",
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "404": {
          "type": "object",
          "description": "\"Page not found\" behavior.",
          "additionalProperties": false,
          "properties": {
            "$ref": { "$ref": "#/definitions/configRef" },
            "redirect": {
              "type": "boolean",
              "description": "Navigate to the docs home when a page is not found. Defaults to true.",
              "default": true
            },
            "title": { "type": "string", "description": "Custom title for the 404 page." },
            "description": {
              "type": "string",
              "description": "Custom description. Supports basic markdown: links, bold, italic, and inline code."
            }
          }
        }
      }
    }
  },
  "definitions": {
    "configRef": {
      "type": "string",
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?![/\\\\]).+\\.json$",
      "description": "Relative path to another JSON configuration file. Resolved relative to the file containing this reference."
    },
    "fontSpec": {
      "type": "object",
      "anyOf": [{ "required": ["$ref"] }, { "required": ["family"] }],
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "family": { "type": "string", "description": "Font family name, e.g. \"Open Sans\"." },
        "weight": { "type": "number", "description": "Font weight, e.g. 400 or 700." },
        "source": { "type": "string", "description": "URL or path to a hosted font file." },
        "format": { "enum": ["woff", "woff2"], "description": "Font file format, for `source`." }
      }
    },
    "pageItem": {
      "anyOf": [
        {
          "type": "string",
          "description": "Page reference relative to the content directory, without extension (e.g. \"components/tabs\")."
        },
        { "$ref": "#/definitions/pageObject" },
        { "$ref": "#/definitions/linkItem" },
        { "$ref": "#/definitions/group" }
      ]
    },
    "pageObject": {
      "type": "object",
      "anyOf": [{ "required": ["$ref"] }, { "required": ["page"] }],
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "page": {
          "type": "string",
          "description": "Page reference relative to the content directory, without extension."
        },
        "title": {
          "type": "string",
          "description": "Custom sidebar label. Overrides the label derived from the file name."
        },
        "label": {
          "type": "string",
          "description": "Custom sidebar label. Takes precedence over title."
        },
        "icon": { "type": "string", "description": "Icon name shown beside the label." },
        "tag": { "type": "string", "description": "Short label shown after the page name." },
        "hidden": {
          "type": "boolean",
          "description": "Hide from the sidebar and search. The page is still built and reachable by URL."
        }
      }
    },
    "linkItem": {
      "type": "object",
      "description": "An external link in the navigation tree.",
      "anyOf": [
        { "required": ["$ref"] },
        {
          "required": ["href"],
          "anyOf": [{ "required": ["label"] }, { "required": ["anchor"] }]
        }
      ],
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "href": { "type": "string", "description": "Destination URL." },
        "label": { "type": "string", "description": "Link text." },
        "anchor": { "type": "string", "description": "Alias for label." },
        "icon": { "type": "string", "description": "Icon name shown beside the label." },
        "hidden": { "type": "boolean", "description": "Hide from the sidebar." },
        "target": { "enum": ["_self", "_blank"] }
      }
    },
    "anchor": {
      "type": "object",
      "anyOf": [{ "required": ["$ref"] }, { "required": ["anchor"] }],
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "anchor": { "type": "string", "description": "Anchor label." },
        "href": { "type": "string", "description": "Destination URL." },
        "icon": { "type": "string", "description": "Icon name shown beside the label." },
        "hidden": { "type": "boolean", "description": "Hide the anchor." },
        "target": { "enum": ["_self", "_blank"] },
        "groups": {
          "x-shiso": "reserved",
          "type": "array",
          "description": "Anchors that contain pages are not implemented yet."
        },
        "pages": {
          "x-shiso": "reserved",
          "type": "array",
          "description": "Anchors that contain pages are not implemented yet."
        }
      }
    },
    "group": {
      "type": "object",
      "anyOf": [{ "required": ["$ref"] }, { "required": ["group", "pages"] }],
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "group": { "type": "string", "minLength": 1, "description": "Group heading shown in the sidebar." },
        "root": {
          "type": "string",
          "description": "Optional landing page for the group. When set, the group title links to this page (chevron still expands/collapses)."
        },
        "pages": { "type": "array", "items": { "$ref": "#/definitions/pageItem" } },
        "icon": { "type": "string", "description": "Icon name shown beside the heading." },
        "expanded": {
          "type": "boolean",
          "description": "When true, nested groups start expanded. Top-level groups start expanded by default. Groups that contain the current page always expand."
        },
        "collapsible": {
          "type": "boolean",
          "description": "When false, the group stays expanded and its heading does not show a collapse control."
        },
        "hidden": {
          "type": "boolean",
          "description": "Hide the group and its pages from the sidebar."
        }
      }
    },
    "dropdown": {
      "type": "object",
      "anyOf": [{ "required": ["$ref"] }, { "required": ["dropdown"] }],
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "dropdown": {
          "type": "string",
          "minLength": 1,
          "description": "Dropdown label rendered by the selected theme."
        },
        "groups": { "type": "array", "items": { "$ref": "#/definitions/group" } },
        "pages": { "type": "array", "items": { "$ref": "#/definitions/pageItem" } },
        "icon": { "type": "string", "description": "Icon name shown beside the label." },
        "hidden": { "type": "boolean", "description": "Hide the dropdown." }
      }
    },
    "tab": {
      "type": "object",
      "anyOf": [{ "required": ["$ref"] }, { "required": ["tab"] }],
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "tab": { "type": "string", "minLength": 1, "description": "Tab label shown in the top navigation." },
        "groups": { "type": "array", "items": { "$ref": "#/definitions/group" } },
        "pages": { "type": "array", "items": { "$ref": "#/definitions/pageItem" } },
        "dropdowns": { "type": "array", "items": { "$ref": "#/definitions/dropdown" } },
        "icon": { "type": "string", "description": "Icon name shown beside the tab label." },
        "hidden": { "type": "boolean", "description": "Hide the tab from the top navigation." }
      }
    },
    "version": {
      "type": "object",
      "anyOf": [{ "required": ["$ref"] }, { "required": ["version"] }],
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "version": {
          "type": "string",
          "description": "Version label. Only the default (or first) version is rendered."
        },
        "default": { "type": "boolean", "description": "Marks this version as the one to render." },
        "hidden": { "type": "boolean", "description": "Hide this version." },
        "tabs": { "type": "array", "items": { "$ref": "#/definitions/tab" } },
        "dropdowns": { "type": "array", "items": { "$ref": "#/definitions/dropdown" } },
        "groups": { "type": "array", "items": { "$ref": "#/definitions/group" } },
        "pages": { "type": "array", "items": { "$ref": "#/definitions/pageItem" } }
      }
    },
    "language": {
      "type": "object",
      "anyOf": [{ "required": ["$ref"] }, { "required": ["language"] }],
      "additionalProperties": false,
      "properties": {
        "$ref": { "$ref": "#/definitions/configRef" },
        "language": {
          "type": "string",
          "description": "Language code or label. Only the default (or first) language is rendered."
        },
        "default": {
          "type": "boolean",
          "description": "Marks this language as the one to render."
        },
        "hidden": { "type": "boolean", "description": "Hide this language." },
        "versions": { "type": "array", "items": { "$ref": "#/definitions/version" } },
        "tabs": { "type": "array", "items": { "$ref": "#/definitions/tab" } },
        "dropdowns": { "type": "array", "items": { "$ref": "#/definitions/dropdown" } },
        "groups": { "type": "array", "items": { "$ref": "#/definitions/group" } },
        "pages": { "type": "array", "items": { "$ref": "#/definitions/pageItem" } }
      }
    }
  }
}

{
  "$schema": "../../../packages/shiso/docs.schema.json",
  "name": "Multi Scope Fixture",
  "description": "Private fixture exercising versions, languages, and nested versions.",
  "redirects": [{ "source": "/docs/old", "destination": "/docs/guide" }],
  "navigation": {
    "anchors": [{ "anchor": "Community", "href": "https://example.com/community" }],
    "languages": [
      {
        "language": "en",
        "default": true,
        "versions": [
          {
            "version": "v2",
            "default": true,
            "tabs": [
              {
                "tab": "Docs",
                "groups": [
                  {
                    "group": "Start",
                    "pages": [
                      { "page": "index", "title": "Introduction" },
                      "guide",
                      { "page": "secret", "hidden": true }
                    ]
                  }
                ]
              }
            ]
          },
          { "version": "v1", "pages": ["v1/index", "v1/guide"] },
          { "version": "v0", "hidden": true, "pages": ["v0/index"] }
        ]
      },
      {
        "language": "es",
        "versions": [
          { "version": "v2", "default": true, "pages": ["es/index", "es/guide"] },
          { "version": "v1", "pages": ["es/v1/index"] }
        ]
      }
    ]
  }
}

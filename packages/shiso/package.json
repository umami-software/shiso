{
  "name": "@umami/shiso",
  "version": "1.1.0",
  "description": "Open-source documentation framework for Markdown and MDX sites.",
  "type": "module",
  "bin": {
    "shiso": "./bin/shiso.mjs"
  },
  "exports": {
    "./client": {
      "types": "./types/client.d.ts",
      "default": "./src/entry-client.tsx"
    },
    "./search": {
      "types": "./types/search.d.ts",
      "default": "./src/lib/search/provider.ts"
    },
    "./schema": "./docs.schema.json",
    "./docs.schema.json": "./docs.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "types",
    "docs.schema.json",
    "mdx.config.ts",
    "vite.config.ts",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "prepack": "pnpm test:package",
    "test:package": "node scripts/check-package.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/umami-software/shiso.git",
    "directory": "packages/shiso"
  },
  "homepage": "https://shiso.umami.is",
  "keywords": [
    "shiso",
    "documentation",
    "docs",
    "mdx",
    "vite"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "estree-util-value-to-estree": "^3.5.0",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.28.0",
    "react-router": "^8.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx": "^3.1.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "remark-parse": "^11.0.0",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "vite": "^8.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
